# =====================================================================
# apps/web - environment template
# ---------------------------------------------------------------------
# Next.js loads `.env.local` from THIS directory (apps/web/), not from the
# repository root. Copy this file to `.env.local` to override the API URL.
#
# RULES:
#   * `NEXT_PUBLIC_*` values are compiled into the browser bundle. They are
#     public by definition - never put a secret here.
#   * `.env.local` is git-ignored. Never commit it.
# =====================================================================

# Base URL the browser uses to reach the API.
# Must match API_HOST/API_PORT in the repository root `.env`.
# The default when unset is http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
