# Normalize line endings: LF in the repository, native on checkout.
* text=auto

# Explicit text types (checked out as LF so Python/TS behaviour is identical
# on every platform).
*.py      text eol=lf
*.pyi     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.ini     text eol=lf
*.cfg     text eol=lf
*.sh      text eol=lf
*.sql     text eol=lf
*.css     text eol=lf
*.html    text eol=lf

# Windows-native scripts.
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Extension-less dotfiles. No pattern above matches a file with no extension,
# so with core.autocrlf=true a fresh clone checked them out as CRLF while the
# working tree here stayed LF. `.prettierrc` then failed Prettier's
# endOfLine=lf rule and `npm run check` failed on a brand-new clone while
# passing locally. Pinned so every checkout is byte-identical.
.editorconfig   text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf
.dockerignore   text eol=lf
.prettierrc     text eol=lf
.prettierignore text eol=lf

# Binary assets.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.whl     binary
*.parquet binary
*.feather binary
*.arrow   binary
