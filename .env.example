# =====================================================================
# HARSH QUANT OS - environment template
# ---------------------------------------------------------------------
# COPY THIS FILE TO `.env` AND FILL IN REAL VALUES.
#
# RULES:
#   * Every value below is a PLACEHOLDER. No real secret lives here.
#   * `.env` is git-ignored. Never commit it.
#   * Never paste real API keys, database passwords, broker credentials
#     or AI provider keys into any tracked file.
#   * Live trading stays DISABLED until Phase 16 is explicitly approved.
# =====================================================================

# ---------- Application ----------
APP_NAME=harsh-quant-os
APP_ENV=development
APP_VERSION=0.1.0-alpha
LOG_LEVEL=INFO
LOG_DIR=logs

# ---------- API ----------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
API_ALLOWED_ORIGINS=http://localhost:3000

# ---------- Web ----------
WEB_HOST=127.0.0.1
WEB_PORT=3000

# ---------- Authentication (generate a real value; see docs/security/secrets-management.md) ----------
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_TOKEN_EXPIRY_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRY_DAYS=7

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql+asyncpg://harsh_quant_os:replace-with-a-local-dev-password@127.0.0.1:5432/harsh_quant_os
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=harsh_quant_os
DATABASE_USER=harsh_quant_os
DATABASE_PASSWORD=replace-with-a-local-dev-password
DATABASE_SSL_MODE=prefer

# ---------- Optional Redis (job queue / caching) ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=false

# ---------- Market data providers (leave blank until a provider is chosen) ----------
# Provider-independent interface: see docs/architecture/data-platform.md
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
HISTORICAL_DATA_PROVIDER=
HISTORICAL_DATA_API_KEY=

# ---------- Local agent bridge ----------
# Shared token between the cloud/API tier and the local compute agent.
LOCAL_AGENT_ENABLED=false
LOCAL_AGENT_HOST=127.0.0.1
LOCAL_AGENT_PORT=8100
LOCAL_AGENT_TOKEN=replace-with-a-long-random-local-agent-token
LOCAL_AGENT_ALLOWED_ROOTS=
LOCAL_AGENT_MAX_CONCURRENT_JOBS=1
LOCAL_AGENT_JOB_TIMEOUT_SECONDS=3600

# ---------- AI research assistant (provider-agnostic, optional) ----------
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_LOCAL_ENABLED=false
AI_LOCAL_MODEL=
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60

# ---------- Notifications (optional) ----------
NOTIFICATIONS_ENABLED=false
NOTIFICATION_EMAIL_HOST=
NOTIFICATION_EMAIL_PORT=587
NOTIFICATION_EMAIL_USER=
NOTIFICATION_EMAIL_PASSWORD=
NOTIFICATION_WEBHOOK_URL=

# ---------- Trading safety switches ----------
# LIVE TRADING IS HARD-DISABLED IN PHASE 0.
# Flipping this flag does NOT enable live trading: the trade gate requires
# Phase 16 completion plus explicit human approval. See SECURITY.md.
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=false
BROKER_PROVIDER=
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCOUNT_ID=
BROKER_BASE_URL=

# ---------- Research capital (paper only) ----------
PAPER_CAPITAL_CURRENCY=INR
PAPER_CAPITAL_AMOUNT=1000

# ---------- Risk engine defaults (independent of strategy logic) ----------
RISK_MAX_POSITION_NOTIONAL=100000
RISK_MAX_DAILY_LOSS=5000
RISK_MAX_OPEN_POSITIONS=5
RISK_DRAWDOWN_KILL_SWITCH_PERCENT=10

# ---------- Cloud / synchronization (Phase 12) ----------
CLOUD_SYNC_ENABLED=false
CLOUD_STORAGE_BUCKET=
CLOUD_REGION=
