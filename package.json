{
  "name": "harsh-quant-os",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "HARSH QUANT OS - private quantitative trading research and backtesting platform. Research, backtesting and paper trading only; live trading is disabled.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/types",
    "packages/shared",
    "apps/web"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run tests/integration",
    "test:py": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\development\\test.ps1 -PythonOnly",
    "build:web": "npm run build --workspace apps/web",
    "api": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\development\\start-dev.ps1 -WithApi",
    "web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\development\\start-dev.ps1 -WithWeb",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\development\\start-dev.ps1",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:py",
    "health": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\development\\health-check.ps1",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup\\setup.ps1",
    "env:provision": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\setup\\provision-env.ps1",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:reset": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\data\\reset-database.ps1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.2"
  }
}
